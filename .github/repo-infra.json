{
  "moving_major_tag": false,
  "version_files": [
    {
      "path": "VERSION",
      "pattern": "^[0-9][^\\n]*$",
      "replacement": "$VERSION",
      "verify": "^$VERSION$"
    }
  ],
  "release_files": [
    "Formula/unspammer.rb"
  ],
  "release_assets": [
    "unspammer-*-x86_64-unknown-linux-musl.tar.gz",
    "unspammer-*-aarch64-unknown-linux-musl.tar.gz",
    "unspammer-*-x86_64-unknown-illumos.tar.gz",
    "unspammer-*-x86_64-apple-darwin.tar.gz",
    "unspammer-*-aarch64-apple-darwin.tar.gz",
    "unspammer-*-x86_64-pc-windows-msvc.zip",
    "unspammer-*-aarch64-pc-windows-msvc.zip",
    "unspammer_*_amd64.deb",
    "unspammer_*_arm64.deb",
    "unspammer-*.x86_64.rpm",
    "unspammer-*.aarch64.rpm",
    "unspammer-*.arm64_sonoma.bottle.tar.gz"
  ],
  "gitea_packages": {
    "url": "https://gitea.oetiker.ch",
    "owner": "oposs",
    "debian": {
      "distribution": "stable",
      "component": "main"
    },
    "rpm": {
      "group": ""
    }
  },
  "exceptions": {
    "demo": "a background IMAP service with no terminal output to record"
  }
}
